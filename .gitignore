# ========================
# DEPENDENCIES (ALL LAYERS)
# ========================
node_modules/
*/node_modules/

# ========================
# ENV FILES (VERY IMPORTANT)
# ========================
.env
.env.local
.env.development
.env.production
.env.test
.env.*.local

# ========================
# LOG FILES
# ========================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ========================
# BUILD OUTPUTS
# ========================
dist/
build/
out/
.next/              # Next.js
coverage/

# ========================
# DOCKER
# ========================
.docker/
docker-data/
*.tar

# ========================
# OS FILES
# ========================
.DS_Store
Thumbs.db

# ========================
# IDE / EDITOR
# ========================
.vscode/
.idea/
*.swp
*.swo

# ========================
# TEMP FILES
# ========================
tmp/
temp/
*.tmp

# ========================
# DATABASE FILES (if any local dumps)
# ========================
*.sqlite
*.db

# ========================
# REDIS / CACHE FILES (if used locally)
# ========================
dump.rdb

# ========================
# COVERAGE / TEST OUTPUT
# ========================
coverage/

# ========================
# OPTIONAL: DOCKER OVERRIDES
# ========================
docker-compose.override.yml

# ========================
# SECURITY (NEVER COMMIT KEYS)
# ========================
*.pem
*.key
*.crt

# ========================
# OPTIONAL BACKUPS
# ========================
*.bak
*.backup